# ─── Kwork Radar — конфиг ───────────────────────────────────────────────
# Скопируй этот файл в .env и заполни значения.

# Токен нового бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой личный chat_id в Telegram (обязательно).
# Как узнать: напиши боту @userinfobot — он пришлёт твой id (число).
CHAT_ID=000000000

# Интервал опроса Kwork в секундах (случайно между min и max).
# Чем меньше — тем быстрее ловишь новые заказы (но тем чаще ходим на сайт).
POLL_MIN_SECONDS=60
POLL_MAX_SECONDS=150

# Ссылка на твоё портфолио (пойдёт в черновик отклика). Пока можно оставить заглушку.
PORTFOLIO_URL=https://t.me/твой_ник

# Минимальный «допустимый» бюджет заказа в рублях (заказы дешевле — игнор).
MIN_BUDGET=1500

# Максимум уведомлений за один цикл опроса (чтобы не заваливало).
# Остаток придёт в следующих циклах. На первом запуске так не завалит.
MAX_NOTIFY=10

# Максимум откликов у заказа: если их больше — не присылать (ловим свежак).
# Поставь побольше (напр. 20), если хочешь видеть и «полежавшие» заказы.
MAX_OFFERS=5

# Прокси для Telegram, ЕСЛИ CityLink режет api.telegram.org на ПК.
# Формат: http://user:pass@host:port  или  socks5://host:port
# Оставь пустым, если Telegram и так работает.
TG_PROXY=

# Показывать браузер (1) или прятать в фон (0). Для отладки поставь 1.
HEADFUL=0
